# Bundle 1 — Ops Telegram (member site flow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PORTAL_URL=

# Bundle 2 — SEO admin Telegram (visit alerts, crawler alerts, deploy notify)
# SEO admin Telegram — IndexNow deploy notify + SEO alerts
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# Bundle 3 — Neon Database (shard 0 = primary; example format below)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Shard-0 alias: used only when DATABASE_URL is unset (silent fallback, lib/database-urls.ts)
DB_1=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Shared read shards DB_2..DB_10 (optional pool spread; unset = single-shard).
# Every shared shard and the backup below REQUIRE CC_ID (lib/database-urls.ts).
DB_2=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_3=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_4=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_5=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_6=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_7=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_8=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_9=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_10=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Last-resort write target when every primary shard is down (requires CC_ID).
DATABASE_BACKUP_FALLBACK=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Cloudflare Access client id for shared-shard auth — example: CC_ID=myclientid123
# Required only when DB_2..DB_10 or DATABASE_BACKUP_FALLBACK are used.
CC_ID=

# Optional Neon project ids per shard — diagnostics/labels only (lib/database-urls.ts)
NEON_PROJECT_ID_1=
NEON_PROJECT_ID_2=
NEON_PROJECT_ID_3=
NEON_PROJECT_ID_4=
NEON_PROJECT_ID_5=
NEON_PROJECT_ID_6=
NEON_PROJECT_ID_7=
NEON_PROJECT_ID_8=
NEON_PROJECT_ID_9=
NEON_PROJECT_ID_10=

# Bundle 6 — Local QA only (never set on production)
ALLOW_LOCAL_TESTING=true
CSP=0
TEST_CRAWLER_TELEGRAM=1
