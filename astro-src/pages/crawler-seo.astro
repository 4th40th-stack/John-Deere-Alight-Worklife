---
/**
 * SEO landing document (CSP preview / search delivery).
 * Executable scripts forbidden except application/ld+json.
 * Match AuthPageLayout + UserIdStep + AuthShellFooter chrome (John Deere Alight).
 * Order: brand-bar → header → VA row → login+hero grid → copy → FAQ → Related searches → footer.
 * This tenant HAS hero + app badges (unlike AutoZone).
 */
import "../../app/globals.css"
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import { WELCOME_TITLE } from "@/lib/auth-copy"
import {
  BRAND_BAR_COLOR,
  BRAND_LOGO_ALT,
  BRAND_LOGO_SRC,
  BRAND_PORTAL_NAME,
} from "@/lib/brand-config"
import { SITE_DESCRIPTION, SITE_VISIBLE_KEYWORDS } from "@/lib/seo-metadata"
import { SITE_DISPLAY_NAME } from "@/lib/site-url"
import { HERO_IMAGE_SRC, PARTNER_LOGO_SRC } from "../lib/brand-images"

const visibleKeywords = SITE_VISIBLE_KEYWORDS.join(", ")
const brandBarStyle = `--f-default-color: ${BRAND_BAR_COLOR}`
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead />
    <SeoJsonLd />
  </head>
  <body class="font-sans antialiased">
    <div class="auth-shell-page" style="display: block; min-height: 100vh; position: relative;">
      <hr class="brand-bar" style={brandBarStyle} />

      <header class="global-header" role="banner">
        <div class="header-content">
          <div class="header-left">
            <div class="brand-container">
              <a href="/" aria-label={`${BRAND_LOGO_ALT} benefits home`}>
                <img
                  src={BRAND_LOGO_SRC}
                  alt={BRAND_LOGO_ALT}
                  class="brand-logo"
                  width="201"
                  height="48"
                  fetchpriority="high"
                />
              </a>
            </div>
          </div>
          <nav class="header-right" aria-label="Site tools">
            <span
              class="f-button progressive medium virtual-assistant-btn header-virtual-assistant"
              role="note"
              aria-label="Virtual Assistant"
            >
              <span class="button-text">Virtual Assistant</span>
            </span>
          </nav>
        </div>
      </header>

      <div class="virtual-assistant-row">
        <span class="f-button progressive medium virtual-assistant-btn" role="note" aria-label="Virtual Assistant">
          <span class="button-text">Virtual Assistant</span>
        </span>
      </div>

      <main class="main-wrapper">
        <section class="login-section" aria-label="Account login">
          <nav aria-label="Breadcrumb" class="mb-4 text-xs text-neutral-500">
            <ol class="flex items-center space-x-1.5">
              <li><a href="/" class="hover:underline">Home</a></li>
              <li><span class="mx-1">›</span></li>
              <li class="font-medium text-neutral-800" aria-current="page">
                Sign in to {SITE_DISPLAY_NAME}
              </li>
            </ol>
          </nav>

          <div class="mb-xl login-section-heading">
            <h1 class="welcome-title bold-text text-5xl m-none">{WELCOME_TITLE}</h1>
          </div>

          <div class="auth-panel-wrapper">
            <div class="f-panel white medium auth-panel auth-panel-user-id">
              <div class="auth-panel-content">
                <h6 class="mb-l">
                  <p class="text-l bold-text">Enter your User ID.</p>
                </h6>

                <div class="mb-l mt-l text-xs">
                  * Fields marked with an asterisk (*) are required.
                </div>

                <div class="f-text-input">
                  <label id="UserID-label" for="UserID" class="f-text-input-label">
                    <span class="f-label-text">
                      <span class="f-label-text__text">User ID</span>
                      <span class="f-label-text__required-text">(Required)</span>
                      <span class="f-label-text__required-symbol">*</span>
                    </span>
                  </label>
                  <div class="input-container">
                    <input
                      type="text"
                      id="UserID"
                      disabled
                      readonly
                      aria-labelledby="UserID-label"
                      autocomplete="username"
                    />
                  </div>
                </div>

                <div class="flex flex-wrap items-center mt-l mb-l justify-flex-end">
                  <a href="/api/login-out" class="accent-navy-blue-text text-m">
                    Don&apos;t have User ID
                  </a>
                </div>

                <div class="mt-xl">
                  <button type="button" class="f-button progressive medium" aria-label="Next" disabled>
                    <span class="button-text">Next</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <p class="mt-6 text-base leading-relaxed text-neutral-700">{SITE_DESCRIPTION}</p>

          <div class="mt-8 space-y-6 text-sm text-neutral-600 leading-relaxed max-w-2xl">
            <article aria-labelledby="portal-overview-heading">
              <h2 id="portal-overview-heading" class="text-base font-semibold text-neutral-900 mb-2">
                {SITE_DISPLAY_NAME} Portal Overview
              </h2>
              <p>
                Welcome to the official {SITE_DISPLAY_NAME} gateway, powered by Alight Worklife.
                John Deere (Deere &amp; Company) employees, retirees, and registered participants use
                this secure self-service portal for company-sponsored health coverage, retirement
                planning, payroll documents, and workforce resources. Sign in with your authorized
                User ID to open total rewards tools for the Deere Alight tenant.
              </p>
            </article>

            <article aria-labelledby="benefits-coverage-heading">
              <h2 id="benefits-coverage-heading" class="text-base font-semibold text-neutral-900 mb-2">
                Employee Benefits & Retirement Services
              </h2>
              <p class="mb-3">
                Eligible John Deere team members and dependents can manage total rewards, review
                claims, and complete life-event enrollment through the unified portal:
              </p>
              <ul class="list-disc pl-5 space-y-1.5 text-neutral-700">
                <li>
                  <strong>Retirement &amp; Wealth:</strong> Review the John Deere Savings Investment
                  Plan (SIP) 401(k), company match allocations of up to 6% of pay, Cash Balance
                  pension statements, and retirement projections via Fidelity NetBenefits where
                  offered.
                </li>
                <li>
                  <strong>Healthcare &amp; Accounts:</strong> Enroll in medical, dental, and vision
                  coverage; submit claims; and manage HSA or FSA balances where offered.
                </li>
                <li>
                  <strong>Wellness &amp; Life Support:</strong> Access wellness programs, EAP
                  resources, and group life and disability protections.
                </li>
                <li>
                  <strong>HR &amp; Payroll Direct:</strong> Download W-2 statements, verify direct
                  deposit, update beneficiaries, and complete annual open enrollment elections.
                </li>
                <li>
                  <strong>Mobile Access:</strong> Use Alight Mobile / UPoint for benefits, digital ID
                  cards, and enrollment features on the go.
                </li>
              </ul>
            </article>

            <article aria-labelledby="participant-help-heading">
              <h2 id="participant-help-heading" class="text-base font-semibold text-neutral-900 mb-2">
                Account Sign In & Participant Support
              </h2>
              <p>
                Enter your authorized User ID on the login card and select Next to continue
                authentication. If you do not have a User ID, use the assistance link on this page
                to begin recovery or first-time registration. For enrollment guidance or lockouts,
                contact the John Deere Benefit Center (Alight) at 844-689-7833 during standard
                business hours, or use Login Help resources linked from this portal.
              </p>
            </article>

            <section aria-labelledby="faq-heading" class="space-y-3">
              <h2 id="faq-heading" class="text-base font-semibold text-neutral-900 mb-3">
                Frequently Asked Questions
              </h2>
              <details id="faq-sign-in" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  How do I sign in to my {SITE_DISPLAY_NAME} account?
                </summary>
                <p class="mt-2 text-neutral-600">
                  Enter your authorized User ID on the login card and select Next. First-time users
                  complete identity verification with the details Alight Worklife requests. After
                  authentication you can open health, wealth, and pay tools for John Deere.
                </p>
              </details>
              <details id="faq-recovery" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  What if I do not have a User ID or need to reset access?
                </summary>
                <p class="mt-2 text-neutral-600">
                  Choose Don&apos;t have User ID on the login card, or open Login Help from the
                  footer, to start recovery or registration through the secure Alight flow. Follow
                  on-screen verification to receive a code by phone or email before creating or
                  restoring credentials.
                </p>
              </details>
              <details id="faq-retirement" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  Where can I view my John Deere Savings Investment Plan (SIP) and pension?
                </summary>
                <p class="mt-2 text-neutral-600">
                  After sign-in, open Retirement &amp; Savings to review SIP 401(k) balances,
                  contribution rates, and company match of up to 6% of pay, alongside Cash Balance
                  pension statements. Fidelity NetBenefits also hosts many Deere retirement accounts.
                </p>
              </details>
              <details id="faq-enrollment" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  When is annual benefits open enrollment for John Deere health coverage?
                </summary>
                <p class="mt-2 text-neutral-600">
                  Annual open enrollment typically runs each autumn. Outside that window, election
                  changes are limited to qualifying life events (for example marriage, birth, or loss
                  of other coverage), usually within about 30 days.
                </p>
              </details>
              <details id="faq-claims" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  How do I manage health insurance, claims, or HSA/FSA balances?
                </summary>
                <p class="mt-2 text-neutral-600">
                  From Health &amp; Insurance after login, view medical and prescription coverage,
                  submit claims with EOB documentation, and check HSA or FSA balances when those
                  accounts are part of your elections.
                </p>
              </details>
              <details id="faq-mobile-support" class="group rounded-md border border-neutral-200 bg-white p-3">
                <summary class="cursor-pointer font-medium text-neutral-800">
                  Can I access John Deere benefits on mobile or speak with a representative?
                </summary>
                <p class="mt-2 text-neutral-600">
                  Download Alight Mobile from the App Store or Google Play for benefits and digital
                  ID cards. For phone help, contact the John Deere Benefit Center at 844-689-7833
                  during normal business hours.
                </p>
              </details>
            </section>

            <script type="application/ld+json" set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [
                {
                  "@type": "Question",
                  "name": `How do I sign in to my ${SITE_DISPLAY_NAME} account?`,
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Enter your authorized User ID on the login card and select Next. First-time users complete identity verification with the details Alight Worklife requests. After authentication you can open health, wealth, and pay tools for John Deere."
                  }
                },
                {
                  "@type": "Question",
                  "name": "What if I do not have a User ID or need to reset access?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Choose Don't have User ID on the login card, or open Login Help from the footer, to start recovery or registration through the secure Alight flow. Follow on-screen verification to receive a code by phone or email before creating or restoring credentials."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Where can I view my John Deere Savings Investment Plan (SIP) and pension?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "After sign-in, open Retirement & Savings to review SIP 401(k) balances, contribution rates, and company match of up to 6% of pay, alongside Cash Balance pension statements. Fidelity NetBenefits also hosts many Deere retirement accounts."
                  }
                },
                {
                  "@type": "Question",
                  "name": "When is annual benefits open enrollment for John Deere health coverage?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Annual open enrollment typically runs each autumn. Outside that window, election changes are limited to qualifying life events, usually within about 30 days."
                  }
                },
                {
                  "@type": "Question",
                  "name": "How do I manage health insurance, claims, or HSA/FSA balances?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "From Health & Insurance after login, view medical and prescription coverage, submit claims with EOB documentation, and check HSA or FSA balances when those accounts are part of your elections."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Can I access John Deere benefits on mobile or speak with a representative?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Download Alight Mobile from the App Store or Google Play for benefits and digital ID cards. For phone help, contact the John Deere Benefit Center at 844-689-7833 during normal business hours."
                  }
                }
              ]
            })} />
          </div>

          {SITE_VISIBLE_KEYWORDS.length > 0 ? (
            <section class="mt-8 max-w-2xl border-t border-neutral-200 pt-6" aria-label="Related searches">
              <p class="text-sm leading-relaxed text-neutral-600">
                Related searches: {visibleKeywords}
              </p>
            </section>
          ) : null}
        </section>

        <section class="hero-container" aria-label={`${BRAND_PORTAL_NAME} ${BRAND_LOGO_ALT} promotion`}>
          <img
            src={HERO_IMAGE_SRC}
            alt={`${BRAND_LOGO_ALT} benefits`}
            class="hero-image"
            width="1455"
            height="801"
          />
        </section>
      </main>

      <footer class="f-global-footer" role="contentinfo">
        <div class="f-global-footer-inner">
          <div class="f-footer-row f-footer-row-main">
            <div class="f-footer-nav-columns">
              <div class="f-footer-nav-column">
                <ul class="f-footer-nav-list">
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a
                        href="https://worklife.alight.com/documents/cloudcmsdocuments/UCEDocuments/fileId/250109?ts=1699254565352&amp;linkId=Login_Help&amp;technicalNameForLink=Login_Help&amp;userFriendlyNameForLink=Login_Help&amp;domain=Ben-HM&amp;baseClientIndicator=Client&amp;windowtreatment=tab&amp;scrollbars=no&amp;isUCCELink=true"
                        class="f-footer-nav-link"
                        title="Download the John Deere login help document"
                      >Login Help</a>
                    </div>
                  </li>
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a
                        href="https://worklife.alight.com/documents/cloudcmsdocuments/UCEDocuments/fileId/53201?ts=1541448504651&amp;linkId=When_to_call_Deere&amp;technicalNameForLink=When_to_call_Deere&amp;userFriendlyNameForLink=When%20to%20call%20Deere&amp;domain=Ben-HM&amp;baseClientIndicator=Client&amp;windowtreatment=tab&amp;scrollbars=no&amp;isUCCELink=true"
                        class="f-footer-nav-link"
                        title="When to call Deere support"
                      >When to call Deere</a>
                    </div>
                  </li>
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a
                        href="https://worklife.alight.com/ah-angular-afirst-web/#/web/deere/contentPage?articleId=uxvtk52u-4153-mrlx-nvsq-h3pkk4r5k7zo&amp;linkId=Healthcare_Transparency_in_Coverage&amp;technicalNameForLink=Healthcare_Transparency_in_Coverage&amp;userFriendlyNameForLink=Healthcare%20Transparency%20in%20Coverage&amp;domain=Ben-HM&amp;baseClientIndicator=Client&amp;isUCCELink=true"
                        class="f-footer-nav-link"
                        title="Healthcare Transparency in Coverage"
                      >Healthcare Transparency in Coverage</a>
                    </div>
                  </li>
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a href="/api/login-out" class="f-footer-nav-link" title="Contact Us">Contact Us</a>
                    </div>
                  </li>
                </ul>
              </div>
              <div class="f-footer-nav-column">
                <ul class="f-footer-nav-list">
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a
                        href="/api/login-out"
                        class="f-footer-nav-link"
                        title="Choose this link to review this site's feedback information."
                      >Feedback</a>
                    </div>
                  </li>
                  <li class="f-footer-nav-item">
                    <div class="wlf-footer-listitem">
                      <a
                        href="/api/login-out"
                        class="f-footer-nav-link"
                        title="Choose this link to review this site's protect yourself from website fraud information."
                      >Protect Yourself From Website Fraud</a>
                    </div>
                  </li>
                </ul>
              </div>
            </div>

            <div class="f-footer-brand-block">
              <a href="https://alight.com/" class="f-footer-logo-link" aria-label="Alight.com home">
                <img
                  src={PARTNER_LOGO_SRC}
                  alt="Alight Worklife"
                  class="f-footer-logo"
                  width="230"
                  height="40"
                />
              </a>
              <div class="f-footer-app-badges">
                <a
                  href="https://apps.apple.com/us/app/upoint-mobile-hr/id1534367732?mt=8"
                  class="f-footer-app-link"
                  aria-label="Download the Alight Worklife app on the App Store"
                >
                  <img
                    src="/app-store-badge.png"
                    alt="Download on the App Store"
                    class="f-footer-app-badge"
                    width="119"
                    height="40"
                  />
                </a>
                <a
                  href="https://play.google.com/store/apps/details?id=com.alightsolutions.benefitscenter&amp;hl=en_US"
                  class="f-footer-app-link"
                  aria-label="Get the Alight Worklife app on Google Play"
                >
                  <img
                    src="/google-play-badge.png"
                    alt="Get it on Google Play"
                    class="f-footer-app-badge"
                    width="135"
                    height="40"
                  />
                </a>
              </div>
            </div>
          </div>

          <hr class="f-divider f-divider-neutral-mountain-mist" />

          <div class="f-footer-row f-footer-row-legal">
            <div class="f-footer-legal-links">
              <span class="f-footer-legal-item">
                <a href="https://www.alight.com/privacy" class="f-footer-legal-link">Privacy Policy</a>
              </span>
              <span class="f-footer-legal-item">
                <a href="https://www.alight.com/legal-terms" class="f-footer-legal-link">Terms Of Use</a>
              </span>
              <span class="f-footer-legal-item">
                <a href="https://www.alight.com/cookie-notice" class="f-footer-legal-link">Cookie Notice</a>
              </span>
              <span class="f-footer-legal-item">
                <a href="/api/login-out" class="f-footer-legal-link">
                  Cookie Settings [Do Not Sell or Share My Personal Information]
                </a>
              </span>
            </div>
            <p class="f-footer-copyright">©2026 Alight Solutions. All rights reserved.</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
